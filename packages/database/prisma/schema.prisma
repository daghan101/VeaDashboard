generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════

enum ShipmentStatus {
  PENDING
  WEIGHING
  COMPLETED
}

enum AnomalyStatus {
  OK
  FIRE
  LOSS
  EXCESS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderSource {
  CUSTOMER_APP
  ADMIN_PANEL
}

enum TransactionType {
  COLLECTION
  PAYMENT
  EXPENSE
  TRANSFER
}

// ══════════════════════════════════════════════════════════
// KULLANICI & YETKİ
// ══════════════════════════════════════════════════════════

model Role {
  id              String   @id @default(uuid())
  name            String   @unique // Admin, Worker
  canSeeRestricted Boolean @default(false) @map("can_see_restricted")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  customerId   String?  @map("customer_id") // Müşteri kullanıcıları için
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role     Role      @relation(fields: [roleId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  // Relations
  shipmentsCreated   Shipment[]     @relation("ShipmentCreator")
  shipmentItemsWeighed ShipmentItem[] @relation("ShipmentItemWeigher")
  ordersCreated      Order[]        @relation("OrderCreator")
  ordersConfirmed    Order[]        @relation("OrderConfirmer")
  ordersPrepared     Order[]        @relation("OrderPreparer")
  transactions       Transaction[]

  @@map("users")
}

// ══════════════════════════════════════════════════════════
// ÜRÜN & ENVANTER
// ══════════════════════════════════════════════════════════

model Product {
  id            String   @id @default(uuid())
  name          String
  category      String   // Dana, Kuzu, Tavuk
  subCategory   String?  @map("sub_category") // But, Kol, Karkas
  unit          String   @default("KG") // KG, ADET
  avgUnitWeight Decimal? @map("avg_unit_weight") @db.Decimal(10, 3)
  fireTolerance Decimal? @map("fire_tolerance") @db.Decimal(5, 4) // 0.0050
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  inventory     Inventory?
  shipmentItems ShipmentItem[]
  orderItems    OrderItem[]

  @@map("products")
}

model Inventory {
  id         String   @id @default(uuid())
  productId  String   @unique @map("product_id")
  quantity   Decimal  @default(0) @db.Decimal(12, 3) // KG veya Adet
  pieceCount Int      @default(0) @map("piece_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("inventory")
}

// ══════════════════════════════════════════════════════════
// TEDARİK (INBOUND) - Mal Kabul
// ══════════════════════════════════════════════════════════

model Vendor {
  id           String   @id @default(uuid())
  name         String
  phone        String?
  totalBalance Decimal  @default(0) @map("total_balance") @db.Decimal(15, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shipments Shipment[]

  @@map("vendors")
}

model Shipment {
  id            String         @id @default(uuid())
  vendorId      String         @map("vendor_id")
  createdById   String         @map("created_by")
  status        ShipmentStatus @default(PENDING)
  declaredTotal Decimal?       @map("declared_total") @db.Decimal(15, 2)
  actualTotal   Decimal?       @map("actual_total") @db.Decimal(15, 2)
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  vendor    Vendor         @relation(fields: [vendorId], references: [id])
  createdBy User           @relation("ShipmentCreator", fields: [createdById], references: [id])
  items     ShipmentItem[]

  @@map("shipments")
}

model ShipmentItem {
  id             String        @id @default(uuid())
  shipmentId     String        @map("shipment_id")
  productId      String        @map("product_id")
  weighedById    String?       @map("weighed_by")
  expectedCount  Int?          @map("expected_count")
  actualCount    Int?          @map("actual_count")
  expectedWeight Decimal?      @map("expected_weight") @db.Decimal(10, 3)
  actualWeight   Decimal?      @map("actual_weight") @db.Decimal(10, 3)
  unitPrice      Decimal?      @map("unit_price") @db.Decimal(10, 2)
  taxRate        Decimal?      @map("tax_rate") @db.Decimal(5, 4) // 0.0800
  anomalyStatus  AnomalyStatus @default(OK) @map("anomaly_status")
  photoUrl       String?       @map("photo_url")
  weighedAt      DateTime?     @map("weighed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  weighedBy User?    @relation("ShipmentItemWeigher", fields: [weighedById], references: [id])

  @@map("shipment_items")
}

// ══════════════════════════════════════════════════════════
// MÜŞTERİ & SİPARİŞ (OUTBOUND)
// ══════════════════════════════════════════════════════════

model Customer {
  id           String   @id @default(uuid())
  businessName String   @map("business_name")
  contactName  String?  @map("contact_name")
  phone        String?
  address      String?
  balanceTry   Decimal  @default(0) @map("balance_try") @db.Decimal(15, 2)
  balanceUsd   Decimal  @default(0) @map("balance_usd") @db.Decimal(15, 2)
  balanceEur   Decimal  @default(0) @map("balance_eur") @db.Decimal(15, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders Order[]
  users  User[]   // Firma çalışanları

  @@map("customers")
}

model Order {
  id           String      @id @default(uuid())
  customerId   String      @map("customer_id")
  createdById  String      @map("created_by")
  confirmedById String?    @map("confirmed_by")
  preparedById String?     @map("prepared_by")
  status       OrderStatus @default(PENDING)
  source       OrderSource @default(CUSTOMER_APP)
  totalAmount  Decimal?    @map("total_amount") @db.Decimal(15, 2)
  notes        String?
  confirmedAt  DateTime?   @map("confirmed_at")
  shippedAt    DateTime?   @map("shipped_at")
  deliveredAt  DateTime?   @map("delivered_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  customer    Customer    @relation(fields: [customerId], references: [id])
  createdBy   User        @relation("OrderCreator", fields: [createdById], references: [id])
  confirmedBy User?       @relation("OrderConfirmer", fields: [confirmedById], references: [id])
  preparedBy  User?       @relation("OrderPreparer", fields: [preparedById], references: [id])
  items       OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String   @map("order_id")
  productId          String   @map("product_id")
  requestedQuantity  Decimal  @map("requested_quantity") @db.Decimal(10, 3)
  confirmedQuantity  Decimal? @map("confirmed_quantity") @db.Decimal(10, 3)
  deliveredQuantity  Decimal? @map("delivered_quantity") @db.Decimal(10, 3) // Müşteriye teslim edilen net
  unitPrice          Decimal? @map("unit_price") @db.Decimal(10, 2)
  subtotal           Decimal? @db.Decimal(12, 2)
  unit               String   @default("KG")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ══════════════════════════════════════════════════════════
// FİNANS & KASA
// ══════════════════════════════════════════════════════════

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique // TRY, USD, EUR
  symbol    String   // ₺, $, €
  rateToTry Decimal  @default(1) @map("rate_to_try") @db.Decimal(10, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts Account[]

  @@map("currencies")
}

model Account {
  id           String   @id @default(uuid())
  currencyId   String   @map("currency_id")
  name         String   // Kasa TRY, Patron USD, ZET
  balance      Decimal  @default(0) @db.Decimal(15, 2)
  isRestricted Boolean  @default(false) @map("is_restricted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  currency     Currency      @relation(fields: [currencyId], references: [id])
  transactions Transaction[]

  @@map("accounts")
}

model Transaction {
  id            String          @id @default(uuid())
  accountId     String          @map("account_id")
  userId        String          @map("user_id")
  referenceId   String?         @map("reference_id") // Order or Shipment ID
  referenceType String?         @map("reference_type") // ORDER, SHIPMENT, MANUAL
  amount        Decimal         @db.Decimal(15, 2)
  type          TransactionType
  maturityDate  DateTime?       @map("maturity_date") @db.Date
  isConfirmed   Boolean         @default(false) @map("is_confirmed")
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("transactions")
}
